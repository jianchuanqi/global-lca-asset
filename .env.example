LCA_GRAPH_BACKEND=neo4j
LCA_NEO4J_URI=bolt://neo4j:7687
LCA_NEO4J_USER=neo4j
LCA_NEO4J_PASSWORD=change-me-for-production
LCA_NEO4J_DATABASE=neo4j
LCA_NEO4J_CONNECTION_TIMEOUT_SECONDS=5
LCA_NEO4J_QUERY_TIMEOUT_SECONDS=10
LCA_NEO4J_MAX_CONNECTION_POOL_SIZE=10
LCA_API_TOKEN=
LCA_ENABLE_EXPERT_CYPHER=false
LCA_CORS_ORIGINS=http://127.0.0.1:3080,http://localhost:3080
LCA_SEED_PATH=/app/data/seed/inventory-v2.public.json
LCA_MCP_ENABLED=true
LCA_MCP_TRUST_PROXY=false
LCA_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*
LCA_MCP_ALLOWED_ORIGINS=http://127.0.0.1:3080,http://localhost:3080
LCA_MCP_MAX_REQUEST_BODY_BYTES=65536

# DeepSeek Harness plugin
GLOBAL_LCA_API_URL=http://127.0.0.1:8000
GLOBAL_LCA_ENABLE_CYPHER=false
