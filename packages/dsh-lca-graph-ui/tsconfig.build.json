{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/index.ts", "src/browser-types.d.ts", "src/client/**/*.ts", "src/client/**/*.tsx"],
  "exclude": ["src/preview", "tests"]
}
