{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jianchuanqi/global-lca-asset/data/candidates/candidate.schema.json",
  "title": "Global LCA Asset candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "status",
    "official_name",
    "asset_type",
    "discovery_date",
    "summary",
    "public_sources",
    "duplicate_check",
    "review_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": { "type": "string", "pattern": "^CAND-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["candidate", "needs-expert-review", "promoted", "rejected-duplicate", "rejected-out-of-scope"] },
    "official_name": { "type": "string", "minLength": 1 },
    "asset_type": { "type": "string", "minLength": 1 },
    "discovery_date": { "type": "string", "format": "date" },
    "summary": { "type": "string", "minLength": 1 },
    "public_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "source_title", "publisher", "access_date", "supported_claims"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "pattern": "^https?://" },
          "source_title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "access_date": { "type": "string", "format": "date" },
          "supported_claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "duplicate_check": {
      "type": "object",
      "required": ["searched_asset_ids", "conclusion"],
      "additionalProperties": false,
      "properties": {
        "searched_asset_ids": { "type": "array", "items": { "type": "string" } },
        "conclusion": { "type": "string", "minLength": 1 }
      }
    },
    "review_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resolution": {
      "type": "object",
      "required": ["decision", "asset_id", "rationale"],
      "additionalProperties": false,
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
